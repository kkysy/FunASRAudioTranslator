<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Ollama Settings"
    Width="760"
    Height="620"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,8,0" Padding="4"
                Background="{ui:ThemeResource SystemFillColorNeutralBackgroundBrush}"
                CornerRadius="8">
            <StackPanel>
                <ui:TextBlock Margin="10,10,10,4" FontSize="18" FontWeight="Bold" Text="Settings" />
                <Button x:Name="PromptButton" Margin="4" Padding="10" Background="Transparent"
                        Click="NavigationButton_Click" Content="Prompt" Tag="Prompt" />
                <Button Margin="4" Padding="10" Background="Transparent"
                        Click="NavigationButton_Click" Content="Ollama" Tag="Ollama" />
                <Button Margin="4" Padding="10" Background="Transparent"
                        Click="NavigationButton_Click" Content="General" Tag="General" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="4"
                Background="{ui:ThemeResource SystemFillColorNeutralBackgroundBrush}"
                CornerRadius="8">
            <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel" Margin="24">
                    <ui:TextBlock Margin="0,0,0,18" FontSize="28" FontWeight="Heavy" Text="Ollama Settings" />

                    <StackPanel x:Name="PromptSection" Margin="0,0,0,20">
                        <ui:TextBlock Margin="0,0,0,8" FontSize="20" FontWeight="Medium" Text="Prompt" />
                        <ui:Card Padding="15">
                            <ui:TextBox x:Name="PromptTextBox" AcceptsReturn="True" MinHeight="150"
                                       Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       TextWrapping="Wrap" />
                        </ui:Card>
                    </StackPanel>

                    <StackPanel x:Name="OllamaSection" Margin="0,0,0,20">
                        <ui:TextBlock Margin="0,0,0,8" FontSize="20" FontWeight="Medium" Text="Ollama" />
                        <ui:Card Padding="15">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <ui:TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                                      FontWeight="Bold" Text="Config" />
                                        <Button Margin="0,0,8,0" Click="PriorButton_Click"
                                                Content="&lt;" Tag="Ollama" />
                                        <ui:TextBlock x:Name="OllamaIndex" VerticalAlignment="Center" Text="1/1" />
                                        <Button Margin="8,0,0,0" Click="NextButton_Click"
                                                Content="&gt;" Tag="Ollama" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,8,0" Click="NewButton_Click" Content="New" Tag="Ollama" />
                                        <Button Click="DeleteButton_Click" Content="Delete" Tag="Ollama" />
                                        <ui:Flyout x:Name="OllamaDeleteFlyout">
                                            <ui:TextBlock Width="180" Text="You must keep at least one config."
                                                          TextWrapping="Wrap" />
                                        </ui:Flyout>
                                    </StackPanel>
                                </Grid>
                                <Separator Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <ui:TextBlock Margin="0,0,0,5" Text="Model Name" />
                                        <ui:TextBox Text="{Binding [Ollama].ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:TextBlock Margin="0,12,0,5" Text="Temperature" />
                                        <ui:NumberBox Minimum="0" Maximum="2" SmallChange="0.1"
                                                      Value="{Binding [Ollama].Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock Margin="0,0,6,5" Text="API URL" />
                                            <ui:Flyout x:Name="OllamaAPIUrlInfoFlyout">
                                                <ui:TextBlock Width="180" Text="Use the Ollama base URL, for example http://localhost:11434."
                                                              TextWrapping="Wrap" />
                                            </ui:Flyout>
                                        </StackPanel>
                                        <ui:TextBox Text="{Binding [Ollama].ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:TextBlock Margin="0,12,0,5" Text="Keep alive (seconds)" />
                                        <ui:NumberBox Minimum="0" Maximum="86400"
                                                      Value="{Binding [Ollama].Keep_alive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
