<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Getting Started"
    Width="700"
    Height="490"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="27"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Header>
                <ui:TextBlock Padding="15,0,0,0" VerticalAlignment="Center">
                    Getting Started
                </ui:TextBlock>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Background="{ui:ThemeResource SystemFillColorNeutralBackgroundBrush}">
            <TextBlock
                Margin="20"
                HorizontalAlignment="Left"
                FontSize="24"
                FontWeight="Bold"
                Text="Welcome to FunASR System Audio Translator!"
                TextAlignment="Left" />
            <ui:TextBlock
                Margin="20,10,20,10"
                TextAlignment="Left"
                TextWrapping="Wrap">
                <Run Text="This build uses local FunASR for Japanese or English speech recognition while retaining the original translation pipeline." />
                <Run Text=" Before first use, complete these steps:&#x0A;" />
                <Run Text="&#x0A;1. Start the local FunASR HTTP server and confirm that its /health endpoint is available." />
                <Run Text="&#x0A;2. Keep the default address http://127.0.0.1:8177, or enter another server address on the settings page." />
                <Run Text="&#x0A;3. Play audio through the Windows default output device. The application captures system output directly; no microphone setup is required." />
                <Run Text="&#x0A;4. Click &quot;Reconnect FunASR&quot; after changing the server address.&#x0A;" />
                <Run Text="&#x0A;The program has automatically navigated to the settings page. After FunASR is connected, switch back to the main page to use real-time translation.&#x0A;" />
                <Run Text="&#x0A;The upstream project is SakiRinn/LiveCaptions-Translator; this build has a separate maintainer and release channel." />
                <Run FontWeight="Bold" Text="&#x0A;&#x0A;Tip:" />
                <Run Text=" The source language can be selected as Japanese or English for FunASR. Target language and Ollama translation settings remain unchanged." />
            </ui:TextBlock>

            <ui:Button
                Margin="0,10,0,0"
                Padding="30,10,30,10"
                HorizontalAlignment="Center"
                Click="CloseButton_Click"
                Content="I have started and configured FunASR." />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
